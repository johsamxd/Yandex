{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventapi;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "BookingBackground": {
    "PollingIntervalSeconds": 5,
    "ProcessingDelaySeconds": 2
  },
  "Jwt": {
    "Secret": "your-very-long-and-secure-secret-key-at-least-32-chars",
    "Issuer": "YandexApi",
    "Audience": "YandexClient",
    "LifetimeMinutes": 60
  }
}
